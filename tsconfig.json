{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"@ampcode/plugin": ["./types/plugin.d.ts"]
		}
	},
	"include": ["index.ts", "src/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
